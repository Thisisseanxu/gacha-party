# HTML 必须每次检查更新，确保用户能拿到最新的 sw.js 和 资源入口
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/*/*.html
  Cache-Control: public, max-age=0, must-revalidate
/*/*/*.html
  Cache-Control: public, max-age=0, must-revalidate
/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
# Service Worker 绝对不能缓存，否则 PWA 无法自动更新
/sw.js
  Cache-Control: public, max-age=0, must-revalidate, no-cache

# 字体文件长期缓存
/*.ttf
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  Cache-Control: public, max-age=31536000, immutable

# Toy 跨域读取卡池；由浏览器校验更新，Toy 另有 15 分钟快照缓存
/data/cards.json
  Access-Control-Allow-Origin: https://www.bilibili.com
  Cache-Control: public, max-age=0, must-revalidate
/data/card_pools_full.json
  Access-Control-Allow-Origin: https://www.bilibili.com
  Cache-Control: public, max-age=0, must-revalidate

# 图片目录（含嵌套目录）允许 B站读取，保留90天缓存
/images/*
  Access-Control-Allow-Origin: https://www.bilibili.com
  Cache-Control: public, max-age=7776000
/*.png
  Cache-Control: public, max-age=7776000
/*.jpg
  Cache-Control: public, max-age=7776000
/*.jpeg
  Cache-Control: public, max-age=7776000
/*.svg
  Cache-Control: public, max-age=7776000
/*.webp
  Cache-Control: public, max-age=7776000
/*.gif
  Cache-Control: public, max-age=7776000
/*.ico
  Cache-Control: public, max-age=7776000

# Vite 编译后的静态资源因为带哈希，可以长期缓存
/assets/*
  Cache-Control: public, max-age=31536000, immutable
