{
  "buildCommand": "npm run build",
  "outputDirectory": "./dist",
  "nodeVersion": "24.5.0",
  "rewrites": [{ "source": "/data/luck-ranking.json", "destination": "/api/luck-ranking-index" }],
  "headers": [
    {
      "source": "/*.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, no-cache"
        }
      ]
    },
    {
      "source": "/test-gacha",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/fenxi/dev",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/quiz/dev",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/huizhang/edit",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/huizhang/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/images/characters/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=7776000"
        }
      ]
    },
    {
      "source": "/images/qban/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=7776000"
        }
      ]
    },
    {
      "source": "/images/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=7776000"
        }
      ]
    },
    {
      "source": "/assets/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=7776000"
        }
      ]
    }
  ],
  "cloudFunctions": {
    "nodejs": { "maxDuration": 120 }
  },
  "schedules": [
    {
      "name": "luck-ranking-start",
      "cron": "15 3 * * *",
      "path": "/api/internal/luck-ranking-update",
      "method": "POST",
      "timezone": "Asia/Shanghai"
    },
    {
      "name": "luck-ranking-continue-1",
      "cron": "20 3 * * *",
      "path": "/api/internal/luck-ranking-update",
      "method": "POST",
      "timezone": "Asia/Shanghai"
    },
    {
      "name": "luck-ranking-continue-2",
      "cron": "25 3 * * *",
      "path": "/api/internal/luck-ranking-update",
      "method": "POST",
      "timezone": "Asia/Shanghai"
    }
  ]
}
